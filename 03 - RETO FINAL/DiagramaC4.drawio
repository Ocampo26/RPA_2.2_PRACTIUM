        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml\n\nskinparam backgroundColor #111111\nskinparam shadowing false\nskinparam defaultFontColor white\nskinparam ArrowColor #CFCFCF\nskinparam ArrowThickness 1.3\n\nLAYOUT_WITH_LEGEND()\n\ntitle C4 - Nivel 2\ntitle Pipeline Automatizado para el Macroentorno del Ecuador\n\nPerson(operador,\&quot;Operador RPA\&quot;,\&quot;Ejecuta pruebas y monitorea resultados\&quot;)\nPerson(cron,\&quot;Planificador\&quot;,\&quot;Programa ejecuciones automáticas\&quot;)\n\nSystem_Ext(fuentes,\&quot;Fuentes Externas\&quot;,\&quot;INEC, BCE, Ministerios\&quot;)\nSystem_Ext(oracle,\&quot;Oracle Database\&quot;,\&quot;Base de datos corporativa\&quot;)\nSystem_Ext(datos,\&quot;Equipo de Datos\&quot;,\&quot;Consume la información\&quot;)\nSystem_Ext(correo,\&quot;Servicio de Notificaciones\&quot;,\&quot;Correo institucional\&quot;)\n\nSystem_Boundary(s1,\&quot;Sistema: Pipeline de Automatización\&quot;){\n\nContainer(trigger,\&quot;Trigger Manual\&quot;,\&quot;n8n\&quot;,\&quot;Inicio manual\&quot;)\n\nContainer(schedule,\&quot;Programador\&quot;,\&quot;n8n\&quot;,\&quot;Ejecución periódica\&quot;)\n\nContainer(orq,\&quot;Motor de Orquestación\&quot;,\&quot;n8n\&quot;,\&quot;Controla el flujo\&quot;)\n\nContainer(extract,\&quot;Extracción\&quot;,\&quot;HTTP/API\&quot;,\&quot;Obtiene información\&quot;)\n\nContainer(validate,\&quot;Validación\&quot;,\&quot;n8n\&quot;,\&quot;Verifica archivos\&quot;)\n\nContainer(raw,\&quot;Repositorio Temporal\&quot;,\&quot;Storage\&quot;,\&quot;Archivos originales\&quot;)\n\nContainer(transform,\&quot;Transformación\&quot;,\&quot;Parser\&quot;,\&quot;Normalización\&quot;)\n\nContainer(etl,\&quot;Integración ETL\&quot;,\&quot;ETL\&quot;,\&quot;Consolida resultados\&quot;)\n\nContainer(errors,\&quot;Gestión de Errores\&quot;,\&quot;n8n\&quot;,\&quot;Reintentos y respaldo\&quot;)\n\nContainerDb(logs,\&quot;Logs\&quot;,\&quot;SQLite\&quot;,\&quot;Historial\&quot;)\n\n}\n\nRel(operador,trigger,\&quot;Inicia\&quot;)\nRel(cron,schedule,\&quot;Programa\&quot;)\n\nRel(trigger,orq,\&quot;\&quot;)\nRel(schedule,orq,\&quot;\&quot;)\n\nRel(orq,extract,\&quot;Solicita\&quot;)\n\nRel(extract,fuentes,\&quot;Consulta\&quot;)\n\nRel(extract,validate,\&quot;Entrega\&quot;)\n\nRel(validate,raw,\&quot;Guarda\&quot;)\n\nRel(validate,errors,\&quot;Error\&quot;)\n\nRel(raw,transform,\&quot;Lee\&quot;)\n\nRel(transform,etl,\&quot;Normaliza\&quot;)\n\nRel(etl,oracle,\&quot;Carga\&quot;)\n\nRel(etl,datos,\&quot;Publica\&quot;)\n\nRel(orq,correo,\&quot;Resumen\&quot;)\n\nRel(errors,logs,\&quot;Registra\&quot;)\n\nRel(orq,logs,\&quot;Auditoría\&quot;)\n\nLay_R(trigger, schedule)\nLay_R(schedule, orq)\nLay_R(orq, extract)\nLay_D(extract, validate)\nLay_L(validate, raw)\nLay_R(validate, transform)\nLay_D(transform, etl)\nLay_L(etl, logs)\nLay_R(etl, oracle)\nLay_R(oracle, datos)\nLay_D(datos, correo)\nLay_L(errors, raw)\n\nSHOW_LEGEND()\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="v1ySdJC-49DRfz2xMsTa-94">
